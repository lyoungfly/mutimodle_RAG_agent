PAPERMIND_DATA_DIR=data
# 已验证的英文 CPU 小模型；按语料语言替换，留空则只启用 BM25。
PAPERMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERMIND_RERANKER_MODEL=cross-encoder/ms-marco-TinyBERT-L2-v2
PAPERMIND_LLM_BASE_URL=http://127.0.0.1:8001/v1
PAPERMIND_LLM_MODEL=
PAPERMIND_LLM_API_KEY=

# 兼容多模态 chat/completions 的视觉服务，配置后重新索引文献。
PAPERMIND_VLM_BASE_URL=http://127.0.0.1:8001/v1
PAPERMIND_VLM_MODEL=
PAPERMIND_VLM_API_KEY=
# 可选图像向量模型，例如 sentence-transformers/clip-ViT-B-32。
PAPERMIND_IMAGE_EMBEDDING_MODEL=
PAPERMIND_MAX_FIGURES=64
PAPERMIND_MAX_VLM_FIGURES=16
